#ifndef SECRETS_H
#define SECRETS_H

// Factory data of the device (flashed during production).
// DEVICE_ID must match the one registered through FactoryDeviceController.
#define DEVICE_ID "esp32-s3-01"

// The raw claim secret. The server stores only its SHA-256 and compares it
// with sha256(received value), so the device sends the RAW value.
#define CLAIM_SECRET "CHANGE_ME_FACTORY_SECRET"

// Backend base URL (no trailing /). Use https in production.
#define API_BASE_URL "http://192.168.1.100:8080"

// MQTT broker. The username/password come from the claim response and are stored in NVS.
#define MQTT_HOST "192.168.1.100"
#define MQTT_PORT 1883

#endif
